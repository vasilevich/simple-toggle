{
  "name": "bots-status-manager",
  "version": "1.3.0",
  "description": "Simple remote toggle and value control server with a reusable Node.js client.",
  "main": "./client/index.cjs",
  "module": "./client/index.mjs",
  "types": "./client/index.d.ts",
  "exports": {
    ".": {
      "types": "./client/index.d.ts",
      "import": "./client/index.mjs",
      "require": "./client/index.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilevich/simple-toggle"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "config": "^3.3.9",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "knex": "^2.4.2",
    "knex-mariadb": "^2.0.0",
    "mariadb": "^3.2.3",
    "random-token-generator": "^1.0.2",
    "sqlite3": "^5.1.6"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node app/index.js"
  }
}
