{
  "name": "bots-status-manager",
  "version": "1.3.0",
  "description": "Simple remote toggle and value control server with reusable JavaScript and Java clients.",
  "main": "./client/js/index.cjs",
  "module": "./client/js/index.mjs",
  "types": "./client/js/index.d.ts",
  "files": [
    "client/js/"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./client/js/index.d.mts",
        "default": "./client/js/index.mjs"
      },
      "require": {
        "types": "./client/js/index.d.ts",
        "default": "./client/js/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilevich/simple-toggle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "body-parser": "^1.20.2",
    "config": "^5.0.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "knex": "^2.4.2",
    "knex-mariadb": "^2.0.0",
    "mariadb": "^3.2.3",
    "random-token-generator": "^1.0.2",
    "sqlite3": "^5.1.6",
    "zod": "^4.5.4"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node app/index.js",
    "test": "node --test test/client.test.cjs"
  }
}
